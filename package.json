{
  "name": "stackpulse",
  "version": "1.0.0",
  "type": "module",
  "description": "StackPulse: Real-time Stacks blockchain event monitoring, analytics, and alerting workspace powered by Hiro Chainhooks.",
  "author": "AdekunleBamz",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdekunleBamz/StackPulse.git"
  },
  "bugs": {
    "url": "https://github.com/AdekunleBamz/StackPulse/issues"
  },
  "homepage": "https://github.com/AdekunleBamz/StackPulse#readme",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=./junit.xml",
    "clarinet:check": "clarinet check",
    "clarinet:test": "clarinet test",
    "lint:all": "npm run lint --prefix frontend && npm run lint --prefix server",
    "build:all": "npm run build --prefix shared && npm run build --prefix server && npm run build --prefix frontend"
  },
  "devDependencies": {
    "@hirosystems/clarinet-sdk": "^2.3.2",
    "@stacks/transactions": "^6.13.0",
    "chokidar-cli": "^3.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "vitest-environment-clarinet": "^2.0.0"
  },
  "keywords": [
    "stacks",
    "blockchain",
    "monitoring",
    "alerts",
    "chainhooks",
    "clarity"
  ],
  "dependencies": {
    "@hirosystems/chainhooks-client": "^1.0.0",
    "undici": "^7.16.0"
  }
}
