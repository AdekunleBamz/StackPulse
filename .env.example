# StackPulse Environment Variables

# Server
PORT=3000
NODE_ENV=development
CHAINHOOKS_API_KEY=your_hiro_api_key
CHAINHOOK_AUTH_TOKEN=your_webhook_secret
DEPLOYER_ADDRESS=your_stacks_address

# Frontend
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_DEPLOYER_ADDRESS=your_deployer_address
NEXT_PUBLIC_STACKPULSE_CONTRACT_VERSION=v-j3
NEXT_PUBLIC_STACKPULSE_CONTRACT_NAME=
NEXT_PUBLIC_ALERT_MANAGER_CONTRACT_NAME=
NEXT_PUBLIC_FEE_VAULT_CONTRACT_NAME=
NEXT_PUBLIC_REPUTATION_BADGES_CONTRACT_NAME=

# Database (optional, for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/stackpulse

# Redis (optional, for future use)
REDIS_URL=redis://localhost:6379
