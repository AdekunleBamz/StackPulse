# StackPulse Environment Variables Template
# Copy this to .env and fill in the values

# ===================
# Environment
# ===================
NODE_ENV=development
TARGET=dev

# ===================
# Server Configuration
# ===================
PORT=3001

# Chainhook Authentication
CHAINHOOK_API_TOKEN=your_chainhook_token_here

# ===================
# Notification Services
# ===================

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Email Service (optional - supports SendGrid, Mailgun, etc.)
EMAIL_SERVICE_API_KEY=your_email_service_key
EMAIL_FROM_ADDRESS=alerts@stackpulse.xyz

# ===================
# External APIs
# ===================

# Hiro API (for enhanced rate limits)
HIRO_API_KEY=your_hiro_api_key
NEXT_PUBLIC_HIRO_API_KEY=your_hiro_api_key

# CoinGecko API (optional, for price data)
COINGECKO_API_KEY=

# ===================
# Frontend Configuration
# ===================
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ===================
# Redis Configuration
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Database (future use)
# ===================
# DATABASE_URL=postgresql://user:password@localhost:5432/stackpulse

# ===================
# Security
# ===================
# JWT secret for session management
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://stackpulse.vercel.app

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===================
# Logging
# ===================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ===================
# Feature Flags
# ===================
ENABLE_TELEGRAM_NOTIFICATIONS=true
ENABLE_DISCORD_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
